{
  "name": "shopkart",
  "version": "1.0.0",
  "description": "Full-stack E-Commerce application with Express, MongoDB Atlas, React, and Razorpay payment gateway",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "npm run build:frontend && node index.js",
    "build:frontend": "npm --prefix SmartKart-Frontend run build",
    "build": "npm run build:frontend",
    "lint": "npm --prefix SmartKart-Frontend run lint",
    "seed": "node seed.js",
    "test": "node --test tests/smartkart2.test.js"
  },
  "workspaces": [
    "SmartKart-Frontend"
  ],
  "keywords": [
    "ecommerce",
    "mern-stack",
    "razorpay",
    "react",
    "express",
    "mongodb",
    "payment-gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ramu-9/SmartKart.git"
  },
  "author": "Ramu",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
