# ==========================================================
# ShopKart Environment Configuration Template
# Copy this file to .env and replace placeholders with your values
# ==========================================================

# Server Port
PORT=3000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/shopkart?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster.mongodb.net/shopkart?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
