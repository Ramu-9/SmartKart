PORT=3000
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Required in production (minimum 16 characters, e.g. openssl rand -hex 32)
JWT_SECRET=
# Storage mode: auto | mongodb | memory
# - mongodb: requires MONGODB_URI, fails fast on startup if unreachable, and never falls back to memory if disconnected
# - memory: uses built-in 38-product in-memory store
# - auto: connects to MONGODB_URI at startup if valid & reachable, otherwise uses in-memory store
STORAGE_MODE=auto
# MongoDB connection string (required when STORAGE_MODE=mongodb)
MONGODB_URI=
# Optional Gemini AI configuration; when omitted, deterministic rule-based fallback is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Razorpay credentials; required for live/test Razorpay gateway orders in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Explicitly allow simulated demo payments ONLY in non-production environments (true | false).
# Ignored in NODE_ENV=production where real Razorpay order creation and HMAC-SHA256 verification are always required.
ALLOW_SIMULATED_PAYMENTS=false
# Optional comma-separated allowed origins when frontend is hosted on a separate domain
CORS_ORIGIN=