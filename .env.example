PORT=3000
JWT_EXPIRES_IN=7d
# Required in production (minimum 16 characters, e.g. openssl rand -hex 32)
JWT_SECRET=
# Storage mode: auto | mongodb | memory (defaults to auto; requires MONGODB_URI when set to mongodb)
STORAGE_MODE=auto
# Optional MongoDB connection string; when omitted in auto/memory mode, in-memory store is used
MONGODB_URI=
# Optional Gemini AI configuration; when omitted, deterministic rule-based fallback is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Razorpay credentials; required for live/test Razorpay gateway orders in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Explicitly allow simulated test payments only in non-production environments (true | false)
ALLOW_SIMULATED_PAYMENTS=false